{
  "id": "/app",
  "name": "Cifraly - Gestão Musical & Repertório",
  "short_name": "Cifraly",
  "description": "Plataforma móvel para gestão de ministérios de louvor, repertório de cifras e Modo Palco ao vivo com transposição.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "theme_color": "#08080a",
  "background_color": "#08080a",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": [
    "music",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon.svg?v=1.0.6",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192x192.png?v=1.0.6",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png?v=1.0.6",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192x192.png?v=1.0.6",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512x512.png?v=1.0.6",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png?v=1.0.6",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Modo Palco",
      "short_name": "Palco",
      "description": "Acessar diretamente o Modo Palco para apresentações",
      "url": "/app",
      "icons": [
        {
          "src": "/icons/icon-192x192.png?v=1.0.6",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Repertório de Cifras",
      "short_name": "Cifras",
      "description": "Consultar repertório e cifras do ministério",
      "url": "/app",
      "icons": [
        {
          "src": "/icons/icon-192x192.png?v=1.0.6",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Eventos e Escalas",
      "short_name": "Escalas",
      "description": "Visualizar próximos cultos e escalas",
      "url": "/app",
      "icons": [
        {
          "src": "/icons/icon-192x192.png?v=1.0.6",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-stage.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Cifraly no Desktop e Tablet com Modo Palco"
    },
    {
      "src": "/screenshots/mobile-stage.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Cifraly no Celular com cifras e transposição"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "share_target": {
    "action": "/app",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/app",
      "name": "Cifras e Partituras",
      "icons": [
        {
          "src": "/icons/icon-192x192.png?v=1.0.6",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "text/plain": [".txt", ".cho", ".cifraly"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+cifraly",
      "url": "/app?action=%s"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=br.com.cifraly.app",
      "id": "br.com.cifraly.app"
    }
  ],
  "prefer_related_applications": false
}
